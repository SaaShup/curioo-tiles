{
  "name": "tiles",
  "version": "2.7.0",
  "description": "Lightweight PNG tile server with real-time map theme editor",
  "author": "SaaShup - CuriooCity",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "dotenv -e .env -- rm -rf cache && node server.js",
    "test:unit": "NODE_ENV=test vitest run --config vitest.unit.config.mjs",
    "test:api-setup": "NODE_ENV=test vitest run --config vitest.api.config.mjs",
    "test:api": "dotenv -e .env-dev -- start-server-and-test start http://localhost:3000 \"npm run test:api-setup\"",
    "test:frontend": "playwright test",
    "test:all": "npm run test:unit && npm run test:api && npm run test:frontend",
    "test": "npm run test:all"
  },
  "keywords": [
    "tiles",
    "osm",
    "map",
    "png",
    "overpass",
    "leaflet"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "keycloak-connect": "^26.1.1",
    "pngjs": "^7.0.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv-cli": "^11.0.0",
    "start-server-and-test": "^3.0.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  }
}
