        "name": "INSTANCE",
        "type": "query",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(tile_requests_total, instance)",
        "query": {
          "query": "label_values(tile_requests_total, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
